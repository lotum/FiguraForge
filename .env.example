# Optional. The app works without provider keys using the included test GLB.
# Keys can also be entered in the web UI; they are never returned to the browser.
OPENAI_API_KEY=
GEMINI_API_KEY=
MESHY_API_KEY=
TRIPO_API_KEY=
# Keep the server local. Set a strong token before using a reverse proxy or LAN.
FORGE_API_TOKEN=
# FORGE_DATA_DIR=/absolute/path/to/figuraforge-data
# Optional external Hunyuan/TRELLIS/custom worker implementing docs/PROVIDERS.md
FORGE_LOCAL_GATEWAY=
LOCAL_API_KEY=
# Optional Fernet key from: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FORGE_VAULT_KEY=
# Approved provider asset domains may be narrowed here. Never include arbitrary user-supplied hosts.
# FORGE_MESHY_CDN_DOMAINS=meshy.ai,assets.meshy.ai,amazonaws.com,cloudfront.net
# FORGE_TRIPO_CDN_DOMAINS=tripo3d.ai,tripo-data.com,amazonaws.com,cloudfront.net

# Per native structural-plane attempt, seconds (3..120); a timed-out child is replaced.
# FORGE_CLIP_TIMEOUT_SECONDS=10

# Hard deadline for each disposable geometry operation; seconds, default 30 minutes.
# FORGE_GEOMETRY_TIMEOUT_SECONDS=1800
